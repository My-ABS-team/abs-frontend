# Copy this to .env.local — never commit .env.local to git

# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:3000/api

# WebSocket endpoint for live NGX market prices
VITE_WS_URL=ws://localhost:3000/ws/market

# Market data provider (NGX feed or third-party like Prembly / Datazapp)
VITE_MARKET_DATA_KEY=your_market_data_key_here

# App environment — controls devtools visibility
VITE_APP_ENV=development
